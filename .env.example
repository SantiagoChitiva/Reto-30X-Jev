# Copia este archivo a .env y pon ahí tus claves. .env está en .gitignore: nunca se sube al repo.

# --- JEV (vía Vercel AI Gateway) ---
# Clave: vercel.com → tu equipo → AI Gateway → API Keys → Create key
# Con la clave puesta, cambia USE_MOCK_JEV a false para usar JEV real.
USE_MOCK_JEV=true
AI_GATEWAY_API_KEY=

# --- LLM de los casos dudosos (ruta llm) ---
# Clave: platform.openai.com → API keys. Sin clave se usa el LLM simulado.
USE_MOCK_LLM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_USD_PER_M_INPUT=0.15
OPENAI_USD_PER_M_OUTPUT=0.60

MAX_CONCURRENCY=50
