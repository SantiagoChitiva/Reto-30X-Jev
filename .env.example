# Copiar a .env (no se sube al repo)
USE_MOCK_JEV=true
JEV_API_KEY=
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# LLM de los casos dudosos (ruta llm). Sin clave se usa el simulado.
USE_MOCK_LLM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_USD_PER_M_INPUT=0.15
OPENAI_USD_PER_M_OUTPUT=0.60
MAX_CONCURRENCY=50
