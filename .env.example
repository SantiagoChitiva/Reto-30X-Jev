# Copia este archivo a .env y pon ahí tus claves. .env está en .gitignore: nunca se sube al repo.

# --- JEV (vía Vercel AI Gateway) ---
# Clave: vercel.com → tu equipo → AI Gateway → API Keys → Create key
# Con la clave puesta, cambia USE_MOCK_JEV a false para usar JEV real.
USE_MOCK_JEV=true
AI_GATEWAY_API_KEY=

# --- LLM de los casos dudosos (ruta llm) ---
# Sirve cualquier API con formato OpenAI. Sin clave se usa el LLM simulado.
# Con la clave puesta, cambia USE_MOCK_LLM a false.
USE_MOCK_LLM=true

# Gemini. Clave: aistudio.google.com → Get API key
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash-lite
# Precio en USD por millón de tokens; confírmalo en ai.google.dev/gemini-api/docs/pricing
LLM_USD_PER_M_INPUT=0.10
LLM_USD_PER_M_OUTPUT=0.40

# OpenAI, en vez de Gemini (clave en platform.openai.com → API keys):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_USD_PER_M_INPUT=0.15
# LLM_USD_PER_M_OUTPUT=0.60

MAX_CONCURRENCY=50
