# Copia este archivo a .env y pon ahí tus claves. .env está en .gitignore: nunca se sube al repo.

# --- JEV (vía Vercel AI Gateway) ---
# Clave: vercel.com → tu equipo → AI Gateway → API Keys → Create key
# Con la clave puesta, cambia USE_MOCK_JEV a false para usar JEV real.
USE_MOCK_JEV=true
AI_GATEWAY_API_KEY=

# --- LLM de los casos dudosos (ruta llm) ---
# Clave: platform.openai.com → API keys. Sin clave se usa el LLM simulado.
USE_MOCK_LLM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_USD_PER_M_INPUT=0.15
OPENAI_USD_PER_M_OUTPUT=0.60

# --- HubSpot (opcional; ver docs/HubSpot.md) ---
# Token de una app privada de HubSpot. Sin token, Pulse acepta webhooks pero no lee ni escribe en HubSpot.
HUBSPOT_TOKEN=
# Secreto de la app, para validar la firma de los webhooks. Sin secreto no se valida (solo desarrollo).
HUBSPOT_CLIENT_SECRET=
# HUBSPOT_SYNC=false            # no escribir las decisiones en HubSpot aunque haya token
# HUBSPOT_WEBHOOK_URL=          # URL pública del webhook, si hay un proxy delante
# HUBSPOT_PROPERTY_MAP={"rol_30x": "role"}        # nombres internos reales de las propiedades de 30X
# HUBSPOT_DEAL_STAGES={"123456": "Calificado"}    # ID de etapa del pipeline de deals → etapa de 30X

MAX_CONCURRENCY=50
